		--
		+ ServerConfig()
		+ getClientMaxBodySize() : int
		+ getCreateFullPutPath() : bool
		+ getDavPutPath() : string
		+ getDavAccess() : string
		+ getDavMethods() : vector<e_Method>
		+ getDefaultType() : string
		+ getErrorPage() : vector<ErrorPage>
		+ getKeepAliveTimeout() : int
		+ getListen() : vector<Listen>
		+ getLocationConfigs() : vector<LocationConfig>
		+ getRoot() : string
		+ getServerName() : vector<string>
		+ getTypes() : map<string, string>
