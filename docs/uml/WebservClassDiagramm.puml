}

namespace webserv.cgi {


}

namespace webserv {

	class "HTTPServer" as HTTPServer <<singleton>> {
		- _logger : log42::logger::Logger
		- _configPath : string
		- _parser : Parser
		- _httpConfig : HTTPConfig
		- _ServerFactory : ServerFactory
		- _Servers : vector<Server>
		- _ioMultiplexer : common::core::io::IEventIO
		- _clientHandler : ClientHandler
		- _statusCodeRegistry : StatusCodeRegistry
		- _typesRegistry : TypesRegistry
		- _headerRegistry : HeaderRegistry
		--
		- HTTPServer()
  		+ {static} getInstance() : HTTPServer
		+ running() : bool
		+ loadConfig() : HTTPConfig
		+ connectClient() : void
		+ getHTTPConfig() : HTTPConfig
		+ getServerFactory() : ServerFactory
		+ getServers() : vector<Server>
		+ setServers(servers : vector<Server>) : void
		+ getIOMultiplexer() : t_ioMultiplexer
		+ setIOMultiplexer(ioMultiplexer : t_ioMultiplexer) : void
	}

	class "ServerFactory" as ServerFactory {
		- {static} _httpConfig : HTTPConfig
		--
		+ ServerFactory()
		+ createServers() : vector<Server>
	}

	class "Server" as Server {
		- _socket4 : common::core::net::TcpServer
		- _socket6 : common::core::net::TcpServer
		- _addrinfo4 : common::core::net::Addrinfo
		- _addrinfo6 : common::core::net::Addrinfo
		- _config : ServerConfig
		- _parser : Parser
		--
		+ Server(config : ServerConfig)
	}

	Client "1" *-- "1" ExecutionHandler
	Client "1" *-- "1" RequestHandler
	Client "1" *-- "1" ResponseHandler
	Client "1" *-- "1" HTTPError
	Client --> ServerConfig : uses
	Client ..> e_ClientFlags : uses
	Client ..> e_ReceiveDataStatus : uses

	ClientHandler "1" *-- "0..*" Client

	ErrorPage "1" *-- "1..*" StatusCode

	ExecutionHandler ..> e_ExecutionHandlerFlags : uses
	
	HTTPConfig "1" *-- "0..*" ErrorPage
	HTTPConfig "1" *-- "1..*" ServerConfig
	
	HTTPHeader ..> HeaderRegistry : uses
	
	HTTPServer "1" *-- "1" ClientHandler
	HTTPServer "1" *-- "1" HeaderRegistry
	HTTPServer "1" *-- "1" HTTPConfig
	HTTPServer "1" *-- "1" Parser
	HTTPServer "1" *-- "1..*" Server
	HTTPServer "1" *-- "1" ServerFactory
	HTTPServer "1" *-- "1" StatusCodeRegistry
	HTTPServer "1" *-- "1" TypesRegistry

	LocationConfig "1" *-- "0..*" ErrorPage
	LocationConfig "1" *-- "0..1" Return
	LocationConfig ..> e_Method : uses
	LocationConfig ..> e_Modifier : uses

	Parser ..> Request : creates
	Parser ..> HTTPConfig : creates
	Parser ..> e_ParserFlags : uses

	ServerConfig "1" *-- "0..*" ErrorPage
	ServerConfig "1" *-- "1..*" Listen
	ServerConfig "1" *-- "0..*" LocationConfig

	ServerFactory ..> Server : creates
	ServerFactory ..> HTTPConfig: uses

	Server "1" *-- "1" Parser
	Server "1" --> "1" ServerConfig : configures

	StatusCode ..> StatusCodeRegistry : uses

	Request ..> HTTPHeader : uses
	Request ..> e_RequestFlags : uses

	RequestHandler "1" *-- "1" Request
	RequestHandler "1" *-- "1" Parser

	Response ..> HTTPHeader : uses
	Response ..> StatusCode : uses
	Response ..> TypesRegistry : uses

	ResponseHandler "1" *-- "1" Response

	Return ..> StatusCode : uses
}

	Client "1" *-- "1" common.core.net.TcpClient

	ClientHandler ..> common.core.io.IEventIO : uses

	Parser ..> abnf.Abnf : uses
	
	HTTPServer "1" *-- "1" log42.logger.Logger
	HTTPServer "1" *-- "1" common.core.io.IEventIO
	HTTPServer ..> common.loader.Loader : uses

	Server "1" *-- "1..2" common.core.net.TcpServer
	Server "1" *-- "1..2" common.core.net.Addrinfo

	ExecutionHandler ..> common.core.utils.Directory : uses
	ExecutionHandler ..> common.core.utils.DirectoryIterator : uses

	HTTPError --|> std.exception : inherits

@enduml
