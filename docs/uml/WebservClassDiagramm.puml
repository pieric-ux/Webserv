title Class Diagram for Webserv 

namespace webserv.headers {

	class "HTTPHeader" as HTTPHeader {
		- _name : string
		- _value : string
		- _description : string
		--
		+ HTTPHeader(name : string, description : string)
		+ HTTPHeader(name : string, value : string, description : string)
		+ getName() : string
		+ getValue() : string
		+ setValue(value : string) : void
		+ getDescription() : string
	}

	class "HeaderRegistry" as HeaderRegistry <<singleton>> {
		- _headers : vector<HTTPHeader>
		--
		+ HeaderRegistry()
  		+ {static} getInstance() : HeaderRegistry
		+ getHeader(name : string) : HTTPHeader
	}
}

namespace webserv.status {

	class "StatusCode" as StatusCode {
		- _code : int
		- _message : string
		- _description : string
		--
		+ StatusCode()
		+ StatusCode(code : int, message : string, description : string)
		+ getCode() : int
		+ getMessage() : string
		+ getDescription() : string
	}

	class "StatusCodeRegistry" as StatusCodeRegistry <<singleton>> {
		- _statusCodes : map<int, StatusCode>
		--
		- StatusCodeRegistry()
  		+ {static} getInstance() : StatusCodeRegistry
		+ getStatusCode(code : int) : StatusCode
	}
}

namespace webserv.types {

	class "TypesRegistry" as TypesRegistry <<singleton>> {
		- _types: map<string, string>
		--
		- TypesRegistry()
  		+ {static} getInstance() : TypesRegistry
		+ getMimeType(extension : string) : string
		+ loadFromFile(filePath : string) : void
		+ addMimeType(extension : string, mimeType : string) : void
	}
}

namespace webserv.client {

	enum "e_RequestFlags" as e_RequestFlags {
		E_REQ_REQUEST_LINE 1 << 0
		E_REQ_HEADERS_VALIDATED 1 << 1
		E_REQ_BODY_STARTED 1 << 2
	}

	class "Request" as Request  {
		- _method : e_Method
		- _requestTarget : string
		- _httpVersion : string
		- _absolutePath : string
		- _headers : vector<list<HTTPHeader>>
		- _body : vector<unsigned char>
		- _flags : e_RequestFlags
		--
		+ Request()
		+ getMethod() : e_Method
		+ setMethod(method : e_Method) : void
		+ getRequestTarget() : string
		+ setRequestTarget(requestTarget : string) : void
		+ getHttpVersion() : string
		+ setHttpVersion(httpVersion : string) : void
		+ getAbsolutePath() : string
		+ setAbsolutePath(absolutePath : string) : void
		+ getHeaders() : vector<list<HTTPHeader>>
		+ setHeaders(headers : vector<list<HTTPHeader>>) : void
		+ getBody() : vector<unsigned char>
		+ setBody(body : vector<unsigned char>) : void
		+ getFlags() : e_RequestFlags
		+ setFlags(flags : e_RequestFlags) : void
	}

	enum "e_ResponseFlags" as e_ResponseFlags {
		E_RESP_HEADERS_SENT 1 << 0
	}

	class "Response" as Response {
		- _httpVersion : string
		- _statusCode : StatusCode
		- _headers : vector<HTTPHeader>
		- _body : vector<unsigned char>
		- _flags : e_ResponseFlags
		--
		+ Response()
		+ getHttpVersion() : string
		+ setHttpVersion(httpVersion : string) : void
		+ getStatusCode() : StatusCode
		+ setStatusCode(statusCode : StatusCode) : void
		+ getHeaders() : vector<list<HTTPHeader>>
		+ setHeaders(headers : vector<list<HTTPHeader>>) : void
		+ getBody() : vector<unsigned char>
		+ setBody(body : vector<unsigned char>) : void
		+ getFlags() : e_RequestFlags
		+ setFlags(flags : e_RequestFlags) : void

	}

	class "HTTPError" as HTTPError <<exception>> {
		- _statusCode : StatusCode
		--
		+ HTTPError(statusCode : StatusCode)
		+ getStatusCode() : StatusCode
		+ setStatusCode(statusCode : StatusCode) : void
		+ what() : string
	}

	class "Client" as Client {
		- _id : int
		- _socket : common::core::net::TcpClient
		- _addrStorage : sockaddr_storage
		- _flags : e_ClientFlags
		- _status : e_ReceiveDataStatus
		- _executionHandler : ExecutionHandler
		- _requestHandler : RequestHandler
		- _serverConfig : ServerConfig
		- _HTTPError : HTTPError
		- _lastActivityTime : int
		--
		- prepareHeadersRequest(buffer : string) : void
		- prepareBodyRequest(buffer : string) : void
		- prepareExecution(requestHandler : RequestHandler, responseHandler : ResponseHandler, serverConfig : ServerConfig) : void
		- prepareHeadersResponse() : void
		- prepareBodyResponse() : void
		+ Client(socket : common::core::net::TcpClient, serverConfig : ServerConfig)
		+ getFlags() : e_ClientFlags
		+ setFlags(flags : e_ClientFlags) : void
		+ getStatus() : e_ReceiveDataStatus
		+ setStatus() : e_ReceiveDataStatus
		+ getExecutionHandler() : ExecutionHandler
		+ getRequestHandler() : RequestHandler
		+ getServerConfig() : ServerConfig
		+ getHTTPError() : HTTPError
		+ setHTTPError(error : HTTPError) : void
		+ getLastActivityTime() : int
		+ setLastActivityTime(time : int) : void
		+ receiveData() : e_ReceiveDataStatus
		+ sendData() : void
	}

	enum "e_ReceiveDataStatus" as e_ReceiveDataStatus {
		E_DISCONNECTED
		E_CLI_REQUEST
	}

	enum "e_ClientFlags" as e_ClientFlags {
		E_CLI_ERR_PARSING 1 << 0
	}
}

namespace webserv.handler {

	class "ClientHandler" as ClientHandler
	{
		- _clients : map<int, Client>
		- _ioMultiplexer : common::core::io::IEventIO
		--
		+ ClientHandler(ioMultiplexer : common::core::io::IEventIO)
		+ addClient(client : Client)
		+ removeClient(client : Client)
		+ processClients(ioMultiplexer : IEventIO) : void
	}

	class "RequestHandler" as RequestHandler {
		- _request : Request
		- _bufferRequest : vector<unsigned char>
		- _parser : Parser
		--
		- parseHeadersFromBufferRequest() : void
		- validateHeaders(serverConfig : ServerConfig) : void
		- parseBodyFromBuffer(serverConfig : ServerConfig) : void
		- buildAbsolutPath(requestTarget : string, locationConfig : LocationConfig) : void
		+ RequestHandler()
		+ getRequest() : Request
		+ setRequest(request : Request) : void
		+ appendToBufferRequest(buffer : string) : void
		+ clearBufferRequest() : void
		+ getParser() : Parser
		+ getBodyReceived() : int
	}

	class "ResponseHandler" as ResponseHandler {
		- _response : Response
		- _bufferResponse : vector<unsigned char>
		--
		- buildStatusLine(httpVersion : string, statusCode : StatusCode, reasonPhrase : string) : void
		- buildHeaders(request : Request) : void
		+ ResponseHandler()
		+ getResponse() : Response
		+ setResponse(response : Response) : void
		+ appendToBufferResponse(buffer : string) : void
		+ clearBufferResponse() : void
	}

	enum "e_ExecutionHandlerFlags" as e_ExecutionHandlerFlags {
		E_EXEC_FILE_OPENED 1 << 0
		E_EXEC_COMPLETE 1 << 1
		E_EXEC_CREATED 1 << 2
		E_EXEC_NOCONTENT 1 << 3
	}

	class "ExecutionHandler" as ExecutionHandler {
		- _fd : int
		- _bodyReceived : int
		- _flags : e_ExecutionFlags
		--
		+ ExecutionHandler()
		+ getFd() : int
		+ setFd(fd : int) : void
		+ getBodyReceived() : int
		+ setBodyReceived(bodyReceived : int) : void
		+ getFlags() : e_ExecutionFlags
		+ setFlags(flags : e_ExecutionFlags) : void
		+ execute(request : Request, response : Response, serverConfig : ServerConfig) : void
		+ executeCGI(request : Request, serverConfig : ServerConfig) : void
		+ executeRequest(request : Request, response : Response, serverConfig : ServerConfig) : void
		- executeHEADorGET(request : Request, response : Response, locationConfig : LocationConfig) : void
		- executePOST(request : Request, response : Response, locationConfig : LocationConfig) : void
		- executeDELETE(request : Request, response : Response, locationConfig : LocationConfig) : void
		- openFile(request : Request, locationConfig : LocationConfig) : int
		- readChunk(fd : int, response : Response) : void
		- writeChunk(fd : int, request : Request) : void
		- getFileSize(fd : int) : int
		- getFileExtension(requestTarget : string) : string
		- generateAutoindexHTML(dirPath : string) : string
		- isFile(requestTarget : string) : bool
		- isFileExisting(requestTarget : string) : bool
		- deleteFile(filePath : string) : void
		- deleteDirectory(dirPath : string) : void
	}
}

namespace webserv.parser {

	enum "e_ParserFlags" as e_ParserFlags {
		E_PARS_HOST 1 << 0
		E_PARS_CONNECTION 1 << 1
		E_PARS_CONTENT_LENGTH 1 << 2
		E_PARS_CONTENT_TYPE 1 << 3
		E_PARS_CONTENT_ENCODING 1 << 4
		E_PARS_EXPECT 1 << 5
		E_PARS_CLRF 1 << 6
	}

	class "Parser" as Parser {
		- {static} _abnfParser : abnf::Abnf
		- {static} _httpConfig : HTTPConfig
		- _flags : e_ParserFlags
		--
		+ Parser()
		+ getFlags() : e_ParserFlags
		+ setFlags(flags : e_ParserFlags) : void
		+ parseConfig(buffer : string) : void
		+ isIPv6Address(address : string) : bool
		+ parseRequestLine(bufferRequest : string) : void
		+ parseHeaders(bufferRequest : string) : vector<HTTPHeader>
	}
}

namespace webserv.config {

	enum "e_Method" as e_Method {
		GET
		HEAD
		POST
		PUT
		DELETE
	}

	enum "e_Modifier" as e_Modifier {
		PREFIX
		EXACT
		PREFIX_PRIORITY
	}

	class "Listen" as Listen <<struct>> {
		+ address : string
		+ port : int
		+ defaultServer : bool
		+ backlog : int
		+ rcvbuf : int
		+ sndbuf : int
		+ bind : bool
		+ ipv6only : bool
		+ reuseport : bool
		+ so_keepalive : bool
	}

	class "Return" as Return <<struct>> {
		+ statusCode : StatusCode
		+ url : string
	}

	class "ErrorPage" as ErrorPage {
		- _codes : vector<StatusCode>
		- _path : string
		--
		+ ErrorPage(codes : vector<StatusCode>, path : string)
	}

	class "HTTPConfig" as HTTPConfig <<singleton>> {
		- _clientMaxBodySize : int
		- _createFullPutPath : bool
		- _davPutPath : string
		- _davAccess : string
		- _davMethods : vector<e_Method>
		- _defaultType : string
		- _errorPage : vector<ErrorPage>
		- _keepAliveTimeout : int
		- _root : string
		- _serverConfigs : vector<ServerConfig>
		- _types : map<string, string>
		- _enableCGI : bool
		- _cgiExtensions : map<string, string>
		--
		- HTTPConfig()
		+ {static} getInstance() : HTTPConfig
		+ getClientMaxBodySize() : int
		+ setClientMaxBodySize(clientMaxBodySize : int) : void
		+ getCreateFullPutPath() : bool
		+ setCreateFullPutPath(createFullPutPath : bool) : void
		+ getDavPutPath() : string
		+ setDavPutPath(davPutPath : string) : void
		+ getDavAccess() : string
		+ setDavAccess(davAcces : string) : void
		+ getDavMethods() : vector<e_Method>
		+ setDavMethods(davMethods : vector<e_Method>) : void
		+ getDefaultType() : string
		+ setDefaultType(defaultType : string) : void
		+ getErrorPage() : vector<ErrorPage>
		+ setErrorPage(errorPage : vector<ErrorPage>) : void
		+ getKeepAliveTimeout() : int
		+ setKeepAliveTimeout(keepAliveTimeout : int) : void
		+ getRoot() : string
		+ setRoot(root : string) : void
		+ getServerConfigs() : vector<ServerConfig>
		+ setServerConfigs(serverConfigs : vector<ServerConfig>) : void
		+ getTypes() : map<string, string>
		+ setTypes(types : map<string, string>) : void
		+ getEnableCGI() : bool
		+ setEnableCGI(enableCGI : bool) : void
		+ getCgiExtensions() : map<string, string>
		+ setCgiExtensions(cgiExstension : map<string, string>) : void
	}

	class "ServerConfig" as ServerConfig {
		- _clientMaxBodySize : int
		- _createFullPutPath : bool
		- _davPutPath : string
		- _davAccess : string
		- _davMethods : vector<e_Method>
		- _defaultType : string
		- _errorPage : vector<ErrorPage>
		- _keepAliveTimeout : int
		- _listen : vector<Listen>
		- _locationConfigs : vector<LocationConfig>
		- _root : string
